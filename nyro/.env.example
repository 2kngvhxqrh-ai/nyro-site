# NYRO configuration. Copy to .env and fill in. Never commit .env.

NYRO_ENV=development
NYRO_PORT=8787
NYRO_HOST=127.0.0.1
NYRO_LOG_LEVEL=info

# Postgres. With docker/docker-compose.yml running, this works as-is.
DATABASE_URL=postgresql://nyro:nyro@localhost:5433/nyro

# REQUIRED. 32 bytes, base64 or hex. Encrypts provider API keys at rest.
# Generate:  openssl rand -base64 32
# Losing this makes every stored API key unreadable — they must be re-entered.
NYRO_SECRET_KEY=

# Optional: creates an Ollama provider row on first run.
# On Windows with Ollama on the host and NYRO in Docker: http://host.docker.internal:11434
# Running NYRO directly on the host instead:              http://localhost:11434
OLLAMA_BASE_URL=http://host.docker.internal:11434

# Origins allowed by CORS. The Vite dev server runs on 5173.
NYRO_CORS_ORIGINS=http://localhost:5173

# Per-request timeout for provider calls.
NYRO_PROVIDER_TIMEOUT_MS=120000

# Enables the in-process MOCK provider (never a real model). Useful for
# verifying the full path before any provider is configured.
NYRO_ENABLE_MOCK_PROVIDER=false

# Used only by `pnpm test`. Point at a THROWAWAY database: the tests delete rows.
TEST_DATABASE_URL=postgresql://nyro:nyro@localhost:5433/nyro_test

# Cloud provider keys are NOT read from here. Add them in the Models UI so they
# are encrypted at rest rather than sitting in a plaintext file.
